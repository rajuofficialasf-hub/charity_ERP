{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://css-erp.assunnahfoundation.org/schemas/user-preferences.json",
  "title": "users.preferences",
  "description": "Per-user preferences (NOTIFICATIONS.md section 5, O-35). Written in T0.16; hijri_date removed in T0.20 (O-43).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "email_mode": { "enum": ["digest", "immediate"], "default": "digest" },
    "digest_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "default": "08:00" },
    "push_opt_in_sessions": { "type": "array", "items": { "type": "string", "format": "uuid" }, "description": "device_sessions with Web Push enabled" }
  }
}
