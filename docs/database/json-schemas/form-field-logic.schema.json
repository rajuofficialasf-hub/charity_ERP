{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://css-erp.assunnahfoundation.org/schemas/form-field-logic.json",
  "title": "form_fields.logic / calculation / settings and form_sections.condition",
  "description": "No-code form logic evaluated by the shared evaluator in packages/shared on the device and on the server (BR-076). Written in T0.16. Field references use field_key.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "show_if": { "$ref": "#/$defs/condition" },
    "required_if": { "$ref": "#/$defs/condition" },
    "options_depend_on": { "type": "string", "description": "field_key whose answer filters field_options.depends_on_option_id (BD-14 branching)" },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "fieldKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "condition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["field", "op"],
          "properties": {
            "field": { "$ref": "#/$defs/fieldKey" },
            "op": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "not_in", "is_empty", "not_empty"] },
            "value": { "description": "a fixed value, or { \"field\": <field_key> } to compare with another answer (D-133)" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["all"],
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "calculation": {
      "type": "object", "additionalProperties": false, "required": ["expr"],
      "properties": {
        "expr": { "$ref": "#/$defs/expr" },
        "round": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "expr": {
      "oneOf": [
        { "type": "number" },
        { "type": "object", "additionalProperties": false, "required": ["field"], "properties": { "field": { "$ref": "#/$defs/fieldKey" } } },
        { "type": "object", "additionalProperties": false, "required": ["sum_repeat"], "properties": { "sum_repeat": { "type": "object", "required": ["group", "field"], "properties": { "group": { "$ref": "#/$defs/fieldKey" }, "field": { "$ref": "#/$defs/fieldKey" } } } } },
        { "type": "object", "additionalProperties": false, "required": ["setting"], "properties": { "setting": { "enum": ["nisab_value"] } } },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "args"],
          "properties": { "op": { "enum": ["add", "sub", "mul", "div", "min", "max", "age_from_dob", "compare_gte"] }, "args": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expr" } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["if", "else"],
          "description": "the first branch whose condition holds, else the last value (D-133)",
          "properties": {
            "if": {
              "type": "array", "minItems": 1, "maxItems": 20,
              "items": { "type": "object", "additionalProperties": false, "required": ["when", "then"], "properties": { "when": { "$ref": "#/$defs/condition" }, "then": { "$ref": "#/$defs/expr" } } }
            },
            "else": { "$ref": "#/$defs/expr" }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["result"], "description": "a text result named by one of the question's settings.results codes", "properties": { "result": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["count_rows"],
          "properties": {
            "count_rows": { "type": "object", "additionalProperties": false, "required": ["group"], "properties": { "group": { "$ref": "#/$defs/fieldKey" }, "where": { "$ref": "#/$defs/condition" } } }
          }
        }
      ]
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "min": { "type": "number" }, "max": { "type": "number" },
        "min_length": { "type": "integer", "minimum": 0 }, "max_length": { "type": "integer", "minimum": 1 },
        "pattern": { "type": "string", "enum": ["nid", "birth_reg", "mobile", "bangla_text", "email", "post_code", "digits"], "description": "a named pattern key only; no regex (D-119)" },
        "message_key": { "type": "string", "description": "i18n key" }
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "placeholder": { "type": "object", "properties": { "bn": { "type": "string" }, "en": { "type": "string" } } },
        "help": { "type": "object", "properties": { "bn": { "type": "string" }, "en": { "type": "string" } } },
        "default": { "description": "{ today: true }, { text } or { number } (D-133)" },
        "read_only": { "type": "boolean", "description": "the answer comes only from the calculation or the default (D-133)" },
        "results": {
          "type": "array", "maxItems": 50,
          "description": "the text results a calculation may give (D-133)",
          "items": { "type": "object", "required": ["code", "label"], "properties": { "code": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" }, "label": { "type": "object", "properties": { "bn": { "type": "string" }, "en": { "type": "string" } } } } }
        },
        "validation": { "$ref": "#/$defs/validation" },
        "repeat": { "type": "object", "properties": { "min_rows": { "type": "integer", "minimum": 0 }, "max_rows": { "type": "integer", "minimum": 1 }, "count_from": { "$ref": "#/$defs/fieldKey", "description": "the earlier whole-number question whose answer gives the number of rows (D-133)" } } },
        "score": {
          "type": "object", "additionalProperties": false,
          "description": "the points of the priority score, set by the Monitoring Team (D-132): per option code of a choice question, or per range of a number (the first matching range counts)",
          "properties": {
            "options": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 } },
            "ranges": {
              "type": "array", "maxItems": 20,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["points"],
                "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "points": { "type": "integer", "minimum": 0, "maximum": 100 } }
              }
            }
          }
        }
      }
    }
  }
}
