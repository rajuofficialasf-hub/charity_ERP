{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://css-erp.assunnahfoundation.org/schemas/project-component-settings.json",
  "title": "project_components.settings",
  "description": "Settings of one project component (T0.16). The component is project_components.component_key; the API selects the matching definition below. Components without settings store {}. anyOf, not oneOf: {} satisfies several optional-only definitions (T1.2).",
  "type": "object",
  "$defs": {
    "bilingual": {
      "type": "object", "additionalProperties": false, "required": ["bn", "en"],
      "properties": { "bn": { "type": "string", "maxLength": 200 }, "en": { "type": "string", "maxLength": 200 } }
    },
    "codeLabel": {
      "type": "object", "additionalProperties": false, "required": ["code", "label"],
      "properties": { "code": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" }, "label": { "$ref": "#/$defs/bilingual" }, "active": { "type": "boolean" } }
    },
    "photoSource": { "enum": ["camera_only", "camera_or_gallery"] },
    "application_form": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "form_ids": { "type": "array", "maxItems": 20, "items": { "type": "string", "format": "uuid" } },
        "beneficiary_class_options": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/codeLabel" } },
        "application_kinds": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/codeLabel" }, "description": "application kinds of an open-application project, e.g. tree planting (BR-068)" }
      }
    },
    "public_link": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" }, "token": { "type": "string", "minLength": 16, "maxLength": 128 }, "form_ids": { "type": "array", "maxItems": 20, "items": { "type": "string", "format": "uuid" } } }
    },
    "volunteer_assignment": {
      "type": "object", "additionalProperties": false,
      "properties": { "team_members_allowed": { "type": "boolean" } }
    },
    "photo_rule": {
      "type": "object", "additionalProperties": false, "required": ["rule"],
      "properties": {
        "rule": { "enum": ["group", "individual", "both", "per_application_type"] },
        "source": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "distribution_proof": { "$ref": "#/$defs/photoSource" },
            "construction_proof": { "$ref": "#/$defs/photoSource" },
            "evidence": { "$ref": "#/$defs/photoSource" },
            "voucher": { "$ref": "#/$defs/photoSource" },
            "payment_copy": { "$ref": "#/$defs/photoSource" }
          }
        },
        "dedup_identical": { "type": "boolean", "default": true, "description": "project-level deduplication policy (O-30)" }
      }
    },
    "stages": {
      "type": "object", "additionalProperties": false, "required": ["list"],
      "properties": { "list": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "object", "additionalProperties": false, "required": ["key", "label"], "properties": { "key": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" }, "label": { "$ref": "#/$defs/bilingual" }, "photo_required": { "type": "boolean" } } } } }
    },
    "issue_log": {
      "type": "object", "additionalProperties": false,
      "properties": { "issue_types": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/codeLabel" } } }
    },
    "volunteer_expenses": {
      "type": "object", "additionalProperties": false,
      "properties": { "categories": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/codeLabel" } } }
    },
    "rating_criteria": {
      "type": "object", "additionalProperties": false, "required": ["criteria"],
      "properties": { "criteria": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/codeLabel" } } }
    },
    "scoring": {
      "type": "object", "additionalProperties": false, "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "label", "max_points", "rule"],
            "properties": {
              "key": { "type": "string", "maxLength": 64 },
              "label": { "$ref": "#/$defs/bilingual" },
              "max_points": { "type": "number", "minimum": 0, "maximum": 100 },
              "rule": { "type": "object", "description": "points by field value: bands for numbers, points per option code, or a not_previously_assisted flag" }
            }
          }
        }
      }
    },
    "follow_up": {
      "type": "object", "additionalProperties": false,
      "properties": { "questions": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/codeLabel" } } }
    },
    "dawah": {
      "type": "object", "additionalProperties": false,
      "properties": { "family_attendance": { "type": "boolean", "default": true }, "gender_split": { "type": "boolean" } }
    }
  },
  "anyOf": [
    { "$ref": "#/$defs/application_form" },
    { "$ref": "#/$defs/public_link" },
    { "$ref": "#/$defs/volunteer_assignment" },
    { "$ref": "#/$defs/photo_rule" },
    { "$ref": "#/$defs/stages" },
    { "$ref": "#/$defs/issue_log" },
    { "$ref": "#/$defs/volunteer_expenses" },
    { "$ref": "#/$defs/rating_criteria" },
    { "$ref": "#/$defs/scoring" },
    { "$ref": "#/$defs/follow_up" },
    { "$ref": "#/$defs/dawah" },
    { "type": "object", "maxProperties": 0 }
  ]
}
