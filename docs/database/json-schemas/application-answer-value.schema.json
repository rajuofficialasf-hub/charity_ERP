{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://css-erp.assunnahfoundation.org/schemas/application-answer-value.json",
  "title": "application_answers.value",
  "description": "Typed answer of one form field (T0.16). The field type comes from form_fields.type; the API validates the value against the branch for that type. Numbers use English digits (UX-05).",
  "oneOf": [
    {
      "$ref": "#/$defs/text"
    },
    {
      "$ref": "#/$defs/number"
    },
    {
      "$ref": "#/$defs/money"
    },
    {
      "$ref": "#/$defs/date"
    },
    {
      "$ref": "#/$defs/time"
    },
    {
      "$ref": "#/$defs/datetime"
    },
    {
      "$ref": "#/$defs/singleChoice"
    },
    {
      "$ref": "#/$defs/multiChoice"
    },
    {
      "$ref": "#/$defs/files"
    },
    {
      "$ref": "#/$defs/gps"
    },
    {
      "$ref": "#/$defs/bdAddress"
    },
    {
      "$ref": "#/$defs/calculated"
    },
    {
      "$ref": "#/$defs/numberTable"
    }
  ],
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "properties": {
        "t": {
          "enum": [
            "short_text",
            "long_text",
            "phone",
            "email",
            "signature_ref"
          ]
        },
        "v": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "number": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "properties": {
        "t": {
          "enum": [
            "number",
            "decimal"
          ]
        },
        "v": {
          "type": "number"
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "properties": {
        "t": {
          "const": "money"
        },
        "v": {
          "type": "string",
          "pattern": "^[0-9]{1,12}(\\.[0-9]{1,2})?$",
          "description": "decimal string, BDT"
        }
      }
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "properties": {
        "t": {
          "const": "date"
        },
        "v": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "properties": {
        "t": {
          "const": "time"
        },
        "v": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "datetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "properties": {
        "t": {
          "const": "datetime"
        },
        "v": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "singleChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "properties": {
        "t": {
          "enum": [
            "single_select",
            "radio"
          ]
        },
        "v": {
          "type": "string",
          "maxLength": 64,
          "description": "field_options.code"
        },
        "other": {
          "type": "string",
          "maxLength": 500,
          "description": "text when the option allows other text (BD-14)"
        }
      }
    },
    "multiChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "properties": {
        "t": {
          "enum": [
            "multi_select",
            "checkbox"
          ]
        },
        "v": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "other": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "properties": {
        "t": {
          "enum": [
            "photo",
            "file",
            "signature"
          ]
        },
        "v": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "description": "files.id or the client_uuid of a queued upload"
          }
        }
      }
    },
    "gps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "lat",
        "lng"
      ],
      "properties": {
        "t": {
          "const": "gps"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracy_m": {
          "type": "number",
          "minimum": 0
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "bdAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "division_id",
        "district_id",
        "upazila_id",
        "union_id"
      ],
      "properties": {
        "t": {
          "const": "bd_address"
        },
        "division_id": {
          "type": "string",
          "format": "uuid"
        },
        "district_id": {
          "type": "string",
          "format": "uuid"
        },
        "upazila_id": {
          "type": "string",
          "format": "uuid"
        },
        "union_id": {
          "type": "string",
          "format": "uuid"
        },
        "village": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "calculated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "properties": {
        "t": {
          "const": "calculation"
        },
        "v": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "computed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "numberTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "v"
      ],
      "description": "whole numbers by row and column key; the validator refuses any row, column or number outside the question's own rows and columns and the whole numbers from 0 to 1,000,000",
      "properties": {
        "t": {
          "const": "number_table"
        },
        "v": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
