  "$id": "https://css-erp.assunnahfoundation.org/schemas/media-work-script.json",
  "title": "media_works.script",
  "description": "The optional parts of a media work's script, each free text (D-101 (6), T2.8b).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
