  outbound_messages ||--o| donor_messages : delivers

  projects ||--o{ dawah_syllabus_topics : teaches
  projects ||--o{ dawah_classes : holds
  dawah_classes ||--o{ class_attendance : records
  beneficiaries ||--o{ class_attendance : attends
  beneficiary_family_members ||--o{ class_attendance : "family attends"
  dawah_syllabus_topics ||--o{ learning_progress : tracks
  beneficiaries ||--o{ learning_progress : learns
