# Optional overrides for infra/docker-compose.dev.yml (copy to infra/.env).
# Development only; the defaults in the compose file work without this file.
# Placeholder values only: never put real secrets here.
POSTGRES_USER=css
POSTGRES_PASSWORD=css_dev_only
POSTGRES_PORT=5433
# SeaweedFS's S3 port on this machine; its key pair is fixed in seaweedfs/s3.json
S3_PORT=8334
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
