{
  "name": "@css/ui",
  "version": "0.0.0",
  "private": true,
  "description": "CSS ERP design system: tokens and base components (T1.4)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@css/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@css/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "src/styles",
    "src/components/**/*.css",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "axe-core": "^4.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@css/config": "workspace:*",
    "@tailwindcss/node": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@css/shared": "workspace:*",
    "@internationalized/date": "3.12.4",
    "lucide-react": "1.55.0",
    "react-aria-components": "1.22.1"
  }
}
