{
  "name": "@css/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript shared by api and web: zod schemas, permission names, i18n keys, business-rule functions",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@css/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./i18n": {
      "@css/source": "./src/i18n/index.ts",
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./format": {
      "@css/source": "./src/format/index.ts",
      "types": "./dist/format/index.d.ts",
      "default": "./dist/format/index.js"
    },
    "./auth": {
      "@css/source": "./src/auth/index.ts",
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./auth/common-passwords": {
      "@css/source": "./src/auth/common-passwords.ts",
      "types": "./dist/auth/common-passwords.d.ts",
      "default": "./dist/auth/common-passwords.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.18",
    "intl-messageformat": "11.2.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@css/config": "workspace:*",
    "typescript": "6.0.3"
  }
}
