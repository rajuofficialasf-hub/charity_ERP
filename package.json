{
  "name": "css-erp",
  "version": "0.0.0",
  "private": true,
  "description": "ERP for the Charity & Social Service Department of As-Sunnah Foundation",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter @css/web --filter @css/api dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter \"./packages/*\" build && pnpm --filter @css/api build && pnpm --filter @css/web build:e2e && pnpm --filter @css/web e2e",
    "lint": "eslint . && prettier --check . && node scripts/check-i18n.mjs",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @css/api db:migrate",
    "db:seed": "pnpm --filter @css/api db:seed",
    "db:reset": "pnpm --filter @css/api db:reset",
    "db:load-locations": "pnpm --filter @css/api db:load-locations",
    "docs:check": "node scripts/check-docs.mjs",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@css/config": "workspace:*",
    "@redocly/cli": "2.62.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "js-yaml": "4.3.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
