# apps/api configuration for local development. Copy to apps/api/.env and adjust.
# Placeholder values only: never commit real secrets (CLAUDE.md, SECURITY_POLICY).
# The defaults match infra/docker-compose.dev.yml.

NODE_ENV=development
STORAGE_DRIVER=s3
PORT=4000

# PostgreSQL 17 from docker compose. Use css_erp_test for automated tests.
DATABASE_URL=postgresql://css:css_dev_only@127.0.0.1:5433/css_erp_dev

# Used from T1.6 onwards (object storage, email, jobs); listed so the names are known.
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_ACCESS_KEY=css_dev_only
# MINIO_SECRET_KEY=css_dev_only_secret
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# JOBS_INLINE=true
