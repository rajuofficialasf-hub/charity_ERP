# apps/api configuration for local development. Copy to apps/api/.env and adjust.
# Placeholder values only: never commit real secrets (docs/security/SECURITY_POLICY.md,
# "Secrets management").
# The defaults match infra/docker-compose.dev.yml.
# Every secret below (change-me…, css_dev_only…) is local only: a production start refuses it.

NODE_ENV=development
PORT=4000
# after SIGTERM, keep serving this long once readiness fails (only behind a proxy that polls it)
SHUTDOWN_DELAY_MS=0


# Email and jobs; listed so the names are known.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# JOBS_INLINE=true

LOG_LEVEL=info
CURSOR_SECRET=change-me-to-a-random-string-of-32-characters
JOBS_INLINE=true
# The S3 store of STORAGE_DRIVER=s3: SeaweedFS from the dev compose file, its whole URL with the
# scheme and port, and its one local key pair (infra/seaweedfs/s3.json). The earlier MINIO_* names
# are refused at start.
S3_ENDPOINT=http://127.0.0.1:8334
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=css_dev_only
S3_SECRET_ACCESS_KEY=css_dev_only_secret
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=CSS ERP <no-reply@example.org>
# The PWA's public origin for links in emails (the set-password link); https in production
APP_ORIGIN=http://127.0.0.1:3000
# Browser origins allowed to call the API with credentials, comma separated, each an exact
# scheme://host[:port]: the web dev server, which calls the API on its own port
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SMS_MODE=logging
# The virus scanner of uploaded files: skip marks them skipped (development and test only);
# production refuses to start until the organization's scanner is configured
FILE_SCANNER=skip
# Emails per minute sent by the delivery worker (default 30)
# EMAIL_PER_MINUTE=30
# The SMS provider's key once a provider is chosen; the channels page shows only whether it is set
# SMS_API_KEY=
# The release shown on the system health page
# APP_VERSION=0.0.0-dev


JWT_SECRET=change-me-to-a-random-string-of-32-characters
JWT_PREVIOUS_SECRET=
AUTH_CSRF_SECRET=change-me-to-a-random-string-of-32-characters
OTP_SECRET=change-me-to-a-random-string-of-32-characters
# Seals the device keys of sessions (docs/architecture/AUTH.md "Tokens and device sessions");
# production refuses this example value.
# During a rotation, LOCAL_KEY_PREVIOUS_SECRET holds the old one until every live session refreshed.
LOCAL_KEY_SECRET=change-me-to-a-random-string-of-32-characters
LOCAL_KEY_PREVIOUS_SECRET=
OTP_DUMMY_ENABLED=true
OTP_DUMMY_CODE=123456
AUTH_COOKIE_SECURE=true
TRUST_PROXY=loopback
RATE_LIMITS_RELAXED=false
SESSION_DEVICE_LIMIT_RELAXED=false
DATABASE_URL=postgresql://css:css_dev_only@127.0.0.1:5433/css_erp_dev
STORAGE_DRIVER=s3
# s3 = SeaweedFS from the dev compose file (TEMP until the NAS is mounted); nas stores under STORAGE_ROOT
# STORAGE_DRIVER=nas
# STORAGE_ROOT=/absolute/path/of/the/nas/mount
