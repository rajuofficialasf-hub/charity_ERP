/// A suggested duplicate pair (the lower id first), kept up to date when a profile changes and nightly
model MergeCandidate {
  lowId      String      @map("low_id") @db.Uuid
  highId     String      @map("high_id") @db.Uuid
  rules      String[]
  active     Boolean     @default(true)
  computedAt DateTime    @default(now()) @map("computed_at") @db.Timestamptz(6)
  low        Beneficiary @relation("beneficiary_merge_candidates_low_id", fields: [lowId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  high       Beneficiary @relation("beneficiary_merge_candidates_high_id", fields: [highId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([lowId, highId])
  @@index([highId], map: "beneficiary_merge_candidates_high_id_idx")
  @@index([lowId, highId], where: raw("active"), map: "beneficiary_merge_candidates_active_idx")
  @@map("beneficiary_merge_candidates")
}

/// A suggested duplicate pair an official marked as two different people (the lower id first)
model MergeDismissal {
  id           String      @id @db.Uuid
  lowId        String      @map("low_id") @db.Uuid
  highId       String      @map("high_id") @db.Uuid
  reason       String
  dismissedBy  String      @map("dismissed_by") @db.Uuid
  dismissedAt  DateTime    @default(now()) @map("dismissed_at") @db.Timestamptz(6)
  liftedBy     String?     @map("lifted_by") @db.Uuid
  liftedAt     DateTime?   @map("lifted_at") @db.Timestamptz(6)
  liftReason   String?     @map("lift_reason")
  low          Beneficiary @relation("beneficiary_merge_dismissals_low_id", fields: [lowId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  high         Beneficiary @relation("beneficiary_merge_dismissals_high_id", fields: [highId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dismissedRef User        @relation("beneficiary_merge_dismissals_dismissed_by", fields: [dismissedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  liftedRef    User?       @relation("beneficiary_merge_dismissals_lifted_by", fields: [liftedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([lowId, highId], where: raw("lifted_at IS NULL"), map: "beneficiary_merge_dismissals_active_key")
  @@index([highId], map: "beneficiary_merge_dismissals_high_id_idx")
  @@index([dismissedBy], map: "beneficiary_merge_dismissals_dismissed_by_idx")
  @@index([liftedBy], map: "beneficiary_merge_dismissals_lifted_by_idx")
  @@map("beneficiary_merge_dismissals")
}

