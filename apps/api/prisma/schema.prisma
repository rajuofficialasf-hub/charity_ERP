  work       MediaWork?    @relation("media_events_work_id", fields: [workId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor      User          @relation("media_events_actor_id", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([referralId, createdAt], map: "media_events_referral_id_created_at_idx")
  @@index([workId], map: "media_events_work_id_idx")
  @@index([actorId], map: "media_events_actor_id_idx")
  @@map("media_events")
}
