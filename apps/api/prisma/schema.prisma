  @@index([createdBy], map: "media_referrals_created_by_idx")
  @@index([updatedBy], map: "media_referrals_updated_by_idx")
  @@map("media_referrals")
}

/// The work of an accepted referral: its stage, members, script, publications, comments, history.
model MediaWork {
  id                  String             @id @db.Uuid
  referralId          String             @unique(map: "media_works_referral_id_key") @map("referral_id") @db.Uuid
  title               String
  stageList           String?            @default("media_stage") @map("stage_list")
  stageCode           String             @map("stage_code")
  /// the stage a work on hold returns to
  heldStageCode       String?            @map("held_stage_code")
  contentType         String             @default("video") @map("content_type")
  script              Json               @default("{}")
  scriptState         String             @default("draft") @map("script_state")
  reviewApprovedBy    String?            @map("review_approved_by") @db.Uuid
  reviewApprovedAt    DateTime?          @map("review_approved_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?            @map("created_by") @db.Uuid
  updatedAt           DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?            @map("updated_by") @db.Uuid
  referral            MediaReferral      @relation("media_works_referral_id", fields: [referralId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stage               ReferenceList?     @relation("media_works_stage_code", fields: [stageList, stageCode], references: [listKey, code], onDelete: Restrict, onUpdate: NoAction)
  reviewApprovedByRef User?              @relation("media_works_review_approved_by", fields: [reviewApprovedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByRef        User?              @relation("media_works_created_by", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updatedByRef        User?              @relation("media_works_updated_by", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  members             MediaWorkMember[]  @relation("media_work_members_work_id")
  publications        MediaPublication[] @relation("media_publications_work_id")
  comments            MediaComment[]     @relation("media_comments_work_id")
  events              MediaEvent[]       @relation("media_events_work_id")

  @@index([stageCode], map: "media_works_stage_code_idx")
  @@index([reviewApprovedBy], map: "media_works_review_approved_by_idx")
  @@index([createdBy], map: "media_works_created_by_idx")
  @@index([updatedBy], map: "media_works_updated_by_idx")
  @@map("media_works")
}

