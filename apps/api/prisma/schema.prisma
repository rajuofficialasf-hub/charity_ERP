// Physical database of the CSS ERP (PostgreSQL 17), written in T1.2 from
// docs/database/DATABASE_SCHEMA.md and ERD.md (91 tables). The data dictionary is the source;
// change both in the same commit. What Prisma cannot express (CHECK constraints, triggers, views,
// the partitioned audit_log, generated columns) lives in the hand-written part of each migration;
// generated columns appear here with their expression as dbgenerated default and are never written
// by the application. Every migration ships with a hand-written down.sql (ADR-003).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model IdSequence {
  scopeKey  String   @id @map("scope_key")
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("id_sequences")
}

