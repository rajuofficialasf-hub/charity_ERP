model AccountInvitation {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique(map: "account_invitations_token_hash_key") @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  emailed      Boolean   @default(false)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String    @map("created_by") @db.Uuid
  user         User      @relation("account_invitations_user_id", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByRef User      @relation("account_invitations_created_by", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([userId], where: raw("used_at IS NULL AND revoked_at IS NULL"), map: "account_invitations_user_id_open_key")
  @@index([userId], map: "account_invitations_user_id_idx")
  @@index([createdBy], map: "account_invitations_created_by_idx")
  @@map("account_invitations")
}

