  applicationId   String       @unique(map: "media_referrals_application_id_key") @map("application_id") @db.Uuid
  beneficiaryId   String       @map("beneficiary_id") @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  referredBy      String       @map("referred_by") @db.Uuid
  priority        String
  note            String
  story           String?
  state           String       @default("pending")
  decidedBy       String?      @map("decided_by") @db.Uuid
  decidedAt       DateTime?    @map("decided_at") @db.Timestamptz(6)
  decisionComment String?      @map("decision_comment")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?      @map("created_by") @db.Uuid
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?      @map("updated_by") @db.Uuid
  application     Application  @relation("media_referrals_application_id", fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  beneficiary     Beneficiary  @relation("media_referrals_beneficiary_id", fields: [beneficiaryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  project         Project      @relation("media_referrals_project_id", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  referredByRef   User         @relation("media_referrals_referred_by", fields: [referredBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decidedByRef    User?        @relation("media_referrals_decided_by", fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByRef    User?        @relation("media_referrals_created_by", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updatedByRef    User?        @relation("media_referrals_updated_by", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  work            MediaWork?   @relation("media_works_referral_id")
  events          MediaEvent[] @relation("media_events_referral_id")

  @@index([beneficiaryId], map: "media_referrals_beneficiary_id_idx")
  @@index([projectId], map: "media_referrals_project_id_idx")
  @@index([referredBy], map: "media_referrals_referred_by_idx")
  @@index([state, createdAt], map: "media_referrals_state_created_at_idx")
