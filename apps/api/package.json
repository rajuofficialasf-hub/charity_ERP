{
  "name": "@css/api",
  "version": "0.0.0",
  "private": true,
  "description": "CSS ERP REST API (NestJS, /api/v1) and, from T1.6, the worker entry point",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && pnpm jobs:install",
    "db:seed": "tsx --conditions=@css/source seed/run.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:migrate:dev": "prisma migrate dev --create-only",
    "db:load-locations": "tsx --conditions=@css/source scripts/load-locations.ts",
    "locations:convert": "tsx --conditions=@css/source scripts/convert-locations.ts",
    "openapi:generate": "tsx --conditions=@css/source scripts/openapi-generate.ts",
    "e2e:server": "tsx --conditions=@css/source scripts/e2e-server.ts",
    "jobs:install": "tsx --conditions=@css/source scripts/jobs-install.ts",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch --conditions=@css/source src/worker.ts"
  },
  "dependencies": {
    "@css/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "jose": "6.2.12",
    "minio": "8.0.7",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.0.6",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@css/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.15.47",
    "@types/express": "5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.7",
    "js-yaml": "4.3.2",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0"
  }
}
