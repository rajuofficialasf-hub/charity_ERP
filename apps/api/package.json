{
  "name": "@css/api",
  "version": "0.0.0",
  "private": true,
  "description": "CSS ERP REST API (Express 5, /api/v1) and the worker entry point",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --conditions=@css/source src/server.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && pnpm jobs:install && pnpm notifications:sync",
    "db:seed": "tsx --env-file-if-exists=.env --conditions=@css/source seed/run.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:migrate:dev": "prisma migrate dev --create-only",
    "db:load-locations": "tsx --conditions=@css/source scripts/load-locations.ts",
    "locations:convert": "tsx --conditions=@css/source scripts/convert-locations.ts",
    "perf:seed": "tsx --conditions=@css/source scripts/perf-seed.ts",
    "perf:lists": "tsx --env-file-if-exists=.env --conditions=@css/source scripts/perf-lists.ts",
    "perf:exports": "tsx --env-file-if-exists=.env --conditions=@css/source scripts/perf-exports.ts",
    "openapi:generate": "tsx --conditions=@css/source scripts/openapi-generate.ts",
    "authz:matrix": "node scripts/authz-matrix.mjs",
    "e2e:server": "tsx --conditions=@css/source scripts/e2e-server.ts",
    "jobs:install": "tsx --env-file-if-exists=.env --conditions=@css/source scripts/jobs-install.ts",
    "notifications:sync": "tsx --env-file-if-exists=.env --conditions=@css/source scripts/notifications-sync.ts",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch --env-file-if-exists=.env --conditions=@css/source src/worker.ts",
    "contract:coverage": "tsx --conditions=@css/source scripts/contract-coverage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/lib-storage": "3.1149.0",
    "@css/shared": "workspace:*",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.6",
    "exceljs": "4.4.0",
    "exifr": "7.1.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "js-yaml": "4.3.2",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "playwright-core": "1.64.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@css/config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "18.0.7",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
