# apps/web configuration for local development. Copy to apps/web/.env.local and adjust.
# VITE_ variables are visible in the browser: never put secrets here.

# The API the dev server's pages call, on its own port; {host} is the page's own host, so this
# computer and a phone on the office network each reach the computer they opened the app from.
# .env.development sets it; a production build refuses it (its calls stay on its own origin).
VITE_API_BASE_URL=http://{host}:4000

# Where `vite preview` (the E2E run) forwards /api/v1, as Caddy does in production.
CSS_API_ORIGIN=http://127.0.0.1:4000
